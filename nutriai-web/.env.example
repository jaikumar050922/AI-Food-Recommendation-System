# =========================================================
# NutriAI Production & Local Environment Configuration
# =========================================================

# --- Security & JWT ---
# Replace with a cryptographically random string in production (e.g. openssl rand -hex 32)
SECRET_KEY=replace-with-a-secure-random-64-character-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Database Configuration ---
# 1. Local Development (Default):
# Leave blank to use the zero-setup local SQLite database (nutriai.db)
# 2. Production Vercel Deployment (Recommended):
# Supply a persistent PostgreSQL connection URI from Neon, Supabase, or Vercel Postgres:
# DATABASE_URL=postgresql://user:password@ep-host.pooler.region.neon.tech/nutriaidb?sslmode=require
DATABASE_URL=

# --- Dataset Location ---
# Optional override for the foods dataset path (defaults to backend/data/foods.csv)
# DATA_PATH=./backend/data/foods.csv

# --- Next.js Frontend Configuration ---
# URL of the Python FastAPI backend for development proxy rewrites
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
BACKEND_URL=http://127.0.0.1:8000
